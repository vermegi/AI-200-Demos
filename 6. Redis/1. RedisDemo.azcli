$repoRoot
$redisHost
$redisPort
$redisDatabase

# Set as environment variables so the Python app can connect to Azure Managed Redis.
$env:REDIS_HOST = $redisHost
$env:REDIS_PORT = $redisPort
$env:REDIS_DATABASE = $redisDatabase

# Configure the Python environment.
cd (Join-Path $repoRoot "6. Redis\amr-data-operations-python")

# python -m venv .venv
.\.venv\Scripts\Activate.ps1
# pip install -r requirements.txt

# Run the Redis data operations console app.
python main.py

deactivate