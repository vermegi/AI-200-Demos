# Implement Semantic Search in Azure Managed Redis
# Microsoft Learn:
# https://microsoftlearning.github.io/mslearn-azure-ai/instructions/azure-managed-redis/03-amr-vector-storage.html

# Use the values captured by deploy\deploy-all.azcli.
$REDIS_HOST = $redisHost
$REDIS_PORT = $redisPort
$REDIS_DATABASE = $redisDatabase

$REDIS_HOST
$REDIS_PORT
$REDIS_DATABASE

# Set the endpoint values as environment variables for the Flask app.
$env:REDIS_HOST = $REDIS_HOST
$env:REDIS_PORT = $REDIS_PORT
$env:REDIS_DATABASE = $REDIS_DATABASE

# Configure the Python environment.
cd "C:\Users\gvermeiren\github\AI-200-Demos\6. Redis\amr-vector-query-python\client"

# DON'T USE THIS ONE!!! IT'S THE WRONG PYTHON VERSION FOR numpyCreate the virtual environment once for this sample.
# python -m venv .venv
# USE THIS INSTEAD!!!
# py install 3.12
