# DO NOT EXECUTE
# Create a Container App named "order-api" with 0.5 CPU, 1.0Gi memory, and scaling between 2 and 20 replicas.
az containerapp create \
  --name order-api \
  --resource-group rg-ecommerce \
  --environment my-environment \
  --image myregistry.azurecr.io/order-api:v1 \
  --cpu 0.5 \
  --memory 1.0Gi \
  --min-replicas 2 \
  --max-replicas 20

# Allow for multiple active revisions to enable gradual rollouts and A/B testing
az containerapp update \
  --name order-api \
  --resource-group rg-ecommerce \
  --revision-mode multiple

# Implement traffic splitting to route 80% of traffic to the current revision and 20% to a new revision for testing
az containerapp ingress traffic set \
  --name order-api \
  --resource-group rg-ecommerce \
  --revision-weight order-api--v1=80 order-api--v2=20


