# ZIP file with starter code: 
# https://github.com/MicrosoftLearning/mslearn-azure-ai/raw/main/downloads/python/app-svc-container-python.zip
# extracted to StarterPythonApp folder
# reusing ACR from previous demo

cd ../../StarterPythonApp

$userHash = "20260616"

$rg = "rg-AI200-$userHash"  # Resource Group name
$location = "francecentral"   # Azure region for the resources

echo $rg

$acrName = "acr$userHash"
$appPlan = "plan-docprocessor-$userHash"
$appName = "app-docprocessor-$userHash"
$containerImage = "docprocessor:v1"

az acr build `
    --resource-group $rg `
    --registry $acrName `
    --image $containerImage `
    --file api/Dockerfile `
    --no-logs `
    --
    api

az appservice plan create `
    --resource-group $rg `
    --name $appPlan `
    --sku P0v3 `
    --location $location `
    --is-linux 

az webapp create `
    --resource-group $rg `
    --plan $appPlan `
    --name $appName `
    --container-image-name "$($acrName).azurecr.io/docprocessor:v1"

# Check in portal: web app will show application error
# Go to log stream - platform - should show credential error for pulling image from ACR

az webapp identity assign `
    --resource-group $rg `
    --name $appName

$PRINCIPAL_ID = az webapp identity show `
    --resource-group $rg `
    --name $appName `
    --query principalId `
    --output tsv

echo $PRINCIPAL_ID

$ACR_ID = az acr show `
    --resource-group $rg `
    --name $acrName `
    --query id `
    --output tsv

az role assignment create `
    --assignee $PRINCIPAL_ID `
    --scope "$ACR_ID/repositories/docprocessor" `
    --role "Container Registry Repository Reader"

az webapp config set `
    --resource-group $rg `
    --name $appName `
    --acr-use-identity true `
    --acr-identity [system]

az webapp config container set `
    --resource-group $rg `
    --name $appName `
    --container-image-name "$($acrName).azurecr.io/docprocessor:v1" `
    --container-registry-url "https://$($acrName).azurecr.io"

az webapp config appsettings set `
    --resource-group $rg `
    --name $appName `
    --settings WEBSITES_PORT=80

az webapp config appsettings set `
    --resource-group $rg `
    --name $appName `
    --settings WEBSITES_ENABLE_APP_SERVICE_STORAGE=true

az webapp config set `
    --resource-group $rg `
    --name $appName `
    --always-on true

az webapp log config `
    --resource-group $rg `
    --name $appName `
    --docker-container-logging filesystem

# check app url at /documents

$APP_URL = az webapp show `
    --resource-group $rg `
    --name $appName `
    --query defaultHostName `
    --output tsv

Write-Host "Application URL: https://$APP_URL"

$body = Get-Content -Raw -Path "document.txt"
Invoke-RestMethod -Method Post -Uri "https://$APP_URL/process" -ContentType "text/plain" -Body $body | ConvertTo-Json -Depth 10


# check app url at /documents again

az webapp log tail `
    --resource-group $rg `
    --name $appName

# Go to kudu console /home/LogFiles/

az webapp config appsettings list `
    --resource-group $rg `
    --name $appName `
    --output table

