$userHash
$repoRoot

cd (Join-Path $repoRoot "1. Containers\StarterPythonApp")

$rg  # Resource Group name
$location   # Azure region for the resources


$acrName
$appName
$containerImage = "docprocessor:v1"

az acr build `
    --resource-group $rg `
    --registry $acrName `
    --image $containerImage `
    --file api/Dockerfile `
    --no-logs `
    --source-acr-auth-id [caller] `
    api

# The web app runs a placeholder image until it is pointed at the ACR image below

az webapp config container set `
    --resource-group $rg `
    --name $appName `
    --container-image-name "$($acrName).azurecr.io/docprocessor:v1" `
    --container-registry-url "https://$($acrName).azurecr.io"

# check app url at /documents
# The web app only accepts traffic through the Azure Front Door private endpoint
# $frontDoorUrl comes from the deploy-all.azcli deployment outputs

Write-Host "Application URL: $frontDoorUrl"

$body = Get-Content -Raw -Path "document.txt"
Invoke-RestMethod -Method Post -Uri "$frontDoorUrl/process" -ContentType "text/plain" -Body $body | ConvertTo-Json -Depth 10


# check app url at /documents again
# the below will NOT work with web app public access disabled!
az webapp log tail `
    --resource-group $rg `
    --name $appName

# Go to kudu console /home/LogFiles/

az webapp config appsettings list `
    --resource-group $rg `
    --name $appName `
    --output table

