# Variables
$userHash = "20260616"
$rg = "rg-AI200-$userHash"
$location = "francecentral"

$acrName = "acr$userHash"
$aksCluster = "aks-$userHash"
$foundryAccount = "foundry-resource-$userHash"
$foundryProjectName = "foundry-project-$userHash"

cd 'C:\Users\gvermeiren\github\AI-200-Demos\3. AKS'

# Confirm that the existing resources are in the expected resource group.
az group show --name $rg
az acr show --resource-group $rg --name $acrName

# Inspect the model deployed to the Microsoft Foundry resource.
$foundryModel = "gpt-5-mini"
$foundryAccount

az cognitiveservices account deployment show `
	--name $foundryAccount `
	--resource-group $rg `
	--deployment-name $foundryModel `
	--output table

$foundryEndpoint

$foundryProjectEndpoint = az cognitiveservices account project show `
	--resource-group $rg `
	--name $foundryAccount `
    --project-name $foundryProject `
	--query properties.endpoints `
	--output tsv
$foundryProjectEndpoint

# Build and push the API image with an ACR Task.
# This uses the caller's existing ACR permissions; admin user credentials are not required.
az acr build `
	--registry $acrName `
	--image aks-api:latest `
	--file .\aks-deploy-python\api\Dockerfile `
    --source-acr-auth-id [caller] `
	.\aks-deploy-python\api\

# Inspect the cluster and the kubelet identity that pulls images and calls Foundry.
az aks show `
	--resource-group $rg `
	--name $aksCluster `
	--query "{name:name, nodeRG:nodeResourceGroup, network:networkProfile.networkPluginMode, subnet:agentPoolProfiles[0].vnetSubnetId}"

# Configure kubectl for the new cluster.
az aks get-credentials `
	--resource-group $rg `
	--name $aksCluster 

# Create a user-specific deployment manifest without changing the template.
# The API authenticates with its AKS managed identity, so no Foundry key is added.
$templateDeploymentFile = ".\\aks-deploy-python\\k8s\\deployment.yaml"
$deploymentFile = ".\\aks-deploy-python\\k8s\\deployment-$userHash.yaml"
(Get-Content $templateDeploymentFile -Raw).Replace("ACR_ENDPOINT", "$acrName.azurecr.io").Replace("FOUNDRY_ENDPOINT", $foundryEndpoint) | Set-Content $deploymentFile -NoNewline

# Apply the completed Deployment and public LoadBalancer Service.
kubectl apply --filename $deploymentFile
kubectl apply --filename .\\aks-deploy-python\\k8s\\service.yaml

# Verify rollout and wait for the public service IP.
kubectl get deploy,svc
kubectl rollout status deployment/aks-api
kubectl get service aks-api-service

# CHANGE API_ENDPOINT in .env to http://external_IP 
# NEW TERMINAL

cd 'C:\Users\gvermeiren\github\AI-200-Demos\3. AKS\aks-deploy-python\client'

# python -m venv labenv

.\labenv\Scripts\Activate.ps1

# python -m pip install -r requirements.txt

python main.py

deactivate


