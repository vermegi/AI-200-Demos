$repoRoot
$eventGridEndpoint
$eventGridTopic
$rg
$eventGridNamespace

# Set as environment variables so the Python app can connect to Azure Event Grid.
$env:EVENTGRID_ENDPOINT = $eventGridEndpoint
$env:EVENTGRID_TOPIC_NAME = $eventGridTopic
$env:RESOURCE_GROUP = $rg
$env:NAMESPACE_NAME = $eventGridNamespace

# Configure the Python environment.
cd (Join-Path $repoRoot "7. Integrate\event-grid-python\client")

# python -m venv .venv
.\.venv\Scripts\Activate.ps1
# pip install -r requirements.txt

# Run the Event Grid Flask app.
python app.py

deactivate
