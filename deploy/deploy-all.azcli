$userHash = "20260902"
$location = "francecentral"

# USE MCAPS ACCOUNT!
az login

$myId = az ad signed-in-user show --query id --output tsv
$templateFile = Join-Path (Get-Location) "deploy\main.bicep"
echo $templateFile
echo $deploymentName = "deploy-all-$userHash"

az deployment sub create `
    --name $deploymentName `
    --location $location `
    --template-file $templateFile `
    --parameters userHash=$userHash location=$location principalId=$myId

$outputs = az deployment sub show --name $deploymentName --query properties.outputs | ConvertFrom-Json

$rg = $outputs.resourceGroup.value
$acrName = $outputs.registry.value
$acrId = $outputs.registryId.value
$acrLoginServer = $outputs.loginServer.value
$appPlan = $outputs.appServicePlan.value
$appName = $outputs.webApp.value
$appUrl = $outputs.webAppUrl.value
$appPrincipalId = $outputs.webAppPrincipalId.value
$frontDoorProfile = $outputs.frontDoorProfile.value
$frontDoorEndpoint = $outputs.frontDoorEndpoint.value
$frontDoorUrl = $outputs.frontDoorUrl.value
$containerAppsEnvironment = $outputs.containerAppsEnvironment.value
$containerAppName = $outputs.containerApp.value
$containerAppUrl = $outputs.containerAppUrl.value
$containerAppPrincipalId = $outputs.containerAppPrincipalId.value
$logAnalyticsWorkspace = $outputs.logAnalyticsWorkspace.value

echo $rg
echo $acrName
echo $acrId
echo $acrLoginServer
echo $appPlan
echo $appName
echo $appUrl
echo $appPrincipalId
echo $frontDoorProfile
echo $frontDoorEndpoint
echo $frontDoorUrl
echo $containerAppsEnvironment
echo $containerAppName
echo $containerAppUrl
echo $containerAppPrincipalId
echo $logAnalyticsWorkspace


$privateEndpointConnectionName = az network private-endpoint-connection list `
  --resource-group $rg `
  --name $appName `
  --type Microsoft.Web/sites `
  --query "[0].name" `
  --output tsv
$privateEndpointConnectionName

az network private-endpoint-connection approve `
  --resource-group $rg `
  --resource-name $appName `
  --type Microsoft.Web/sites `
  --name $privateEndpointConnectionName `
  --description "Approved for Azure Front Door Premium"
