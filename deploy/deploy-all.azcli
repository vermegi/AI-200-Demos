$repoRoot = Get-Location
$userHash = "20260902"
$location = "francecentral"
$embeddingsApiKey = "demo-key-12345"

# USE MCAPS ACCOUNT!
az login

$myId = az ad signed-in-user show --query id --output tsv
$myUpn = az ad signed-in-user show --query userPrincipalName --output tsv
$myId
$myUpn
$templateFile = Join-Path $repoRoot "deploy\main.bicep"
echo $templateFile
$deploymentName = "deploy-all-$userHash"
$deploymentName

az deployment sub create `
    --name $deploymentName `
    --location $location `
    --template-file $templateFile `
    --parameters userHash=$userHash location=$location principalId=$myId userPrincipalName=$myUpn embeddingsApiKey=$embeddingsApiKey

$outputs = az deployment sub show --name $deploymentName --query properties.outputs | ConvertFrom-Json

$rg = $outputs.resourceGroup.value
$acrName = $outputs.registry.value
$acrId = $outputs.registryId.value
$acrLoginServer = $outputs.loginServer.value
$appPlan = $outputs.appServicePlan.value
$appName = $outputs.webApp.value
$appUrl = $outputs.webAppUrl.value
$appPrincipalId = $outputs.webAppPrincipalId.value
$frontDoorProfile = $outputs.frontDoorProfile.value
$frontDoorEndpoint = $outputs.frontDoorEndpoint.value
$frontDoorUrl = $outputs.frontDoorUrl.value
$containerAppsEnvironment = $outputs.containerAppsEnvironment.value
$containerAppName = $outputs.containerApp.value
$containerAppUrl = $outputs.containerAppUrl.value
$containerAppPrincipalId = $outputs.containerAppPrincipalId.value
$manageContainerApp = $outputs.manageContainerApp.value
$manageContainerAppUrl = $outputs.manageContainerAppUrl.value
$manageContainerAppPrincipalId = $outputs.manageContainerAppPrincipalId.value
$scaleContainerApp = $outputs.scaleContainerApp.value
$scaleContainerAppUrl = $outputs.scaleContainerAppUrl.value
$scaleContainerAppPrincipalId = $outputs.scaleContainerAppPrincipalId.value
$logAnalyticsWorkspace = $outputs.logAnalyticsWorkspace.value
$foundryAccount = $outputs.foundryAccount.value
$foundryEndpoint = $outputs.foundryEndpoint.value
$foundryProject = $outputs.foundryProject.value
$foundryModelDeployment = $outputs.foundryModelDeployment.value
$aksCluster = $outputs.aksCluster.value
$aksKubeletObjectId = $outputs.aksKubeletObjectId.value
$cosmosAccount = $outputs.cosmosAccount.value
$cosmosEndpoint = $outputs.cosmosEndpoint.value
$cosmosDatabase = $outputs.cosmosDatabase.value
$cosmosContainer = $outputs.cosmosContainer.value
$cosmosVectorDatabase = $outputs.cosmosVectorDatabase.value
$cosmosVectorContainer = $outputs.cosmosVectorContainer.value
$cosmosIndexOptimizationDatabase = $outputs.cosmosIndexOptimizationDatabase.value
$cosmosIndexOptimizationContainers = $outputs.cosmosIndexOptimizationContainers.value
$cosmosClientIdentityClientId = $outputs.cosmosClientIdentityClientId.value
$postgresServer = $outputs.postgresServer.value
$postgresHost = $outputs.postgresHost.value
$postgresDatabase = $outputs.postgresDatabase.value
$postgresAdmin = $outputs.postgresAdmin.value
$redisCluster = $outputs.redisCluster.value
$redisHost = $outputs.redisHost.value
$redisDatabase = $outputs.redisDatabase.value
$redisPort = $outputs.redisPort.value
$redisAccessAssignment = $outputs.redisAccessAssignment.value
$serviceBusNamespace = $outputs.serviceBusNamespace.value
$serviceBusResourceId = $outputs.serviceBusResourceId.value
$serviceBusFqdn = $outputs.serviceBusFqdn.value
$serviceBusQueue = $outputs.serviceBusQueue.value
$serviceBusTopic = $outputs.serviceBusTopic.value
$serviceBusNotificationsSubscription = $outputs.serviceBusNotificationsSubscription.value
$serviceBusHighPrioritySubscription = $outputs.serviceBusHighPrioritySubscription.value
$serviceBusHighPriorityRule = $outputs.serviceBusHighPriorityRule.value

echo $rg
echo $acrName
echo $acrId
echo $acrLoginServer
echo $appPlan
echo $appName
echo $appUrl
echo $appPrincipalId
echo $frontDoorProfile
echo $frontDoorEndpoint
echo $frontDoorUrl
echo $containerAppsEnvironment
echo $containerAppName
echo $containerAppUrl
echo $containerAppPrincipalId
echo $manageContainerApp
echo $manageContainerAppUrl
echo $manageContainerAppPrincipalId
echo $scaleContainerApp
echo $scaleContainerAppUrl
echo $scaleContainerAppPrincipalId
echo $logAnalyticsWorkspace
echo $foundryAccount
echo $foundryEndpoint
echo $foundryProject
echo $foundryModelDeployment
echo $aksCluster
echo $aksKubeletObjectId
echo $cosmosAccount
echo $cosmosEndpoint
echo $cosmosDatabase
echo $cosmosContainer
echo $cosmosVectorDatabase
echo $cosmosVectorContainer
echo $cosmosIndexOptimizationDatabase
echo $cosmosIndexOptimizationContainers
echo $cosmosClientIdentityClientId
echo $postgresServer
echo $postgresHost
echo $postgresDatabase
echo $postgresAdmin
echo $redisCluster
echo $redisHost
echo $redisDatabase
echo $redisPort
echo $redisAccessAssignment
echo $serviceBusNamespace
echo $serviceBusResourceId
echo $serviceBusFqdn
echo $serviceBusQueue
echo $serviceBusTopic
echo $serviceBusNotificationsSubscription
echo $serviceBusHighPrioritySubscription
echo $serviceBusHighPriorityRule


$privateEndpointConnectionName = az network private-endpoint-connection list `
  --resource-group $rg `
  --name $appName `
  --type Microsoft.Web/sites `
  --query "[0].name" `
  --output tsv
$privateEndpointConnectionName

az network private-endpoint-connection approve `
  --resource-group $rg `
  --resource-name $appName `
  --type Microsoft.Web/sites `
  --name $privateEndpointConnectionName `
  --description "Approved for Azure Front Door Premium"
